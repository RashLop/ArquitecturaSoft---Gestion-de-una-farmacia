@page
@model ProyectoArqSoft.Pages.VentaCreateModel
@{
    ViewData["Title"] = "Registro de Venta";
}

<div class="container py-5">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h3 class="mb-0">Nueva Venta</h3>
        </div>

        <div class="card-body">
            <form method="post" asp-page-handler="CrearVenta" id="ventaCreateForm">

                <!-- IMPORTANTE -->
                <input type="hidden" asp-for="DetallesJson" id="DetallesJson" />

                <div class="row mb-4">

                    <!-- CLIENTE -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Cliente (NIT)</label>

                        <input type="text"
                            id="clienteBusqueda"
                            class="form-control"
                            placeholder="Buscar por NIT..." />

                        <div id="clienteResultados" class="list-group mt-1"></div>

                        <label class="form-label fw-bold mt-2">Cliente:</label>
                        <input type="text"
                            id="razonSocialCliente"
                            class="form-control"
                            placeholder="Razón social del cliente"
                            readonly />

                        <input type="hidden"
                            asp-for="IdCliente"
                            id="IdCliente" />
                    </div>

                    <!-- METODO PAGO -->
                    <div class="col-md-6">
                        <label asp-for="MetodoPago" class="form-label fw-bold"></label>
                        <select asp-for="MetodoPago" class="form-select" required>
                            <option value="">Seleccione</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="QR">QR</option>
                        </select>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between mb-3">
                    <h5>Detalle</h5>
                    <button type="button"
                            class="btn btn-success"
                            id="btnAgregarDetalle">
                        + Agregar medicamento
                    </button>
                </div>

                <table class="table table-bordered" id="tablaDetalles">
                    <thead class="table-success">
                        <tr>
                            <th>Medicamento</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="detalleBody"></tbody>
                </table>

                <div class="text-end mb-3">
                    <h5>Total: <span id="totalVenta">Bs. 0.00</span></h5>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Estado.MensajeError))
                {
                    <div class="alert alert-danger">
                        @Model.Estado.MensajeError
                    </div>
                }

                <div class="text-end">
                    <button type="submit"
                            class="btn btn-primary"
                            id="btnGuardarVenta">
                        Guardar Venta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        const clientes = [
            @foreach (System.Data.DataRow row in Model.ClienteDataTable.Rows)
            {
                    <text>
                    {
                        id: @row["id"],
                        nit: "@row["nit"]",
                        razonSocial: "@row["razon_social"]"
                    },
                    </text>
            }
        ];

        const medicamentos = [
            @foreach (System.Data.DataRow row in Model.MedicamentoDataTable.Rows)
            {
                    <text>
                    {
                        id: @row["id"],
                        nombre: "@row["nombre"]",
                        precio: @(Convert.ToDecimal(row["precio"]).ToString(System.Globalization.CultureInfo.InvariantCulture))
                    },
                    </text>
            }
        ];
    </script>

    <script>
        const detalleBody = document.getElementById("detalleBody");
        const detallesJsonInput = document.getElementById("DetallesJson");
        const totalVentaSpan = document.getElementById("totalVenta");

        function crearFila() {
            const tr = document.createElement("tr");

            tr.innerHTML = `
                <td>
                    <input type="text"
                           class="form-control medicamento-busqueda"
                           placeholder="Buscar medicamento">

                    <div class="medicamento-resultados list-group mt-1"></div>

                    <input type="text"
                           class="form-control medicamento-nombre mt-1"
                           placeholder="Seleccionado"
                           readonly>

                    <input type="hidden" class="medicamento-id">
                </td>

                <td>
                    <input type="number"
                           min="1"
                           class="form-control cantidad-input"
                           value="1">
                </td>

                <td>
                      <input type="number"
                        class="form-control precio-input bg-light"
                        value="0"
                        readonly
                        style="pointer-events:none;">

                </td>

                <td>
                    <span class="subtotal-text">0.00</span>
                </td>

                <td>
                    <button type="button"
                            class="btn btn-danger btnEliminarFila">
                        X
                    </button>
                </td>
            `;

            detalleBody.appendChild(tr);

            const busqueda = tr.querySelector(".medicamento-busqueda");
            const resultados = tr.querySelector(".medicamento-resultados");
            const nombre = tr.querySelector(".medicamento-nombre");
            const hiddenId = tr.querySelector(".medicamento-id");
            const cantidad = tr.querySelector(".cantidad-input");
            const precio = tr.querySelector(".precio-input");

            busqueda.addEventListener("input", function () {
                const texto = this.value.toLowerCase();
                resultados.innerHTML = "";

                if (texto.length < 2) return;

                const filtrados = medicamentos.filter(m =>
                    m.nombre.toLowerCase().includes(texto)
                );

                filtrados.forEach(med => {
                    const item = document.createElement("button");
                    item.type = "button";
                    item.className = "list-group-item list-group-item-action";
                    item.textContent = med.nombre;

                    item.onclick = function () {
                        nombre.value = med.nombre;
                        hiddenId.value = med.id;
                        precio.value = med.precio;
                        busqueda.value = "";
                        resultados.innerHTML = "";
                        recalcularFila(tr);
                    };

                    resultados.appendChild(item);
                });
            });

            cantidad.addEventListener("input", () => recalcularFila(tr));

            tr.querySelector(".btnEliminarFila")
                .addEventListener("click", function () {
                    tr.remove();
                    sincronizarJson();
                });

            recalcularFila(tr);
        }

        function recalcularFila(tr) {
            const cantidad = Number(
                tr.querySelector(".cantidad-input").value || 0
            );

            const precio = Number(
                tr.querySelector(".precio-input").value || 0
            );

            const subtotal = cantidad * precio;

            tr.querySelector(".subtotal-text").textContent =
                subtotal.toFixed(2);

            sincronizarJson();
        }

        function sincronizarJson() {
            const filas = detalleBody.querySelectorAll("tr");

            const detalles = [];
            let total = 0;

            filas.forEach(tr => {
                const idMedicamento = Number(
                    tr.querySelector(".medicamento-id").value || 0
                );

                const cantidad = Number(
                    tr.querySelector(".cantidad-input").value || 0
                );

                const precio = Number(
                    tr.querySelector(".precio-input").value || 0
                );

                if (idMedicamento > 0) {
                    detalles.push({
                        IdMedicamento: idMedicamento,
                        Cantidad: cantidad
                    });
 
                    total += cantidad * precio;
                }
            });

            detallesJsonInput.value = JSON.stringify(detalles);
            totalVentaSpan.textContent = "Bs. " + total.toFixed(2);

            console.log("JSON:", detallesJsonInput.value);
        }

        document.getElementById("btnAgregarDetalle")
            .addEventListener("click", crearFila);

        document.getElementById("ventaCreateForm")
            .addEventListener("submit", function () {
                sincronizarJson();
            });

        crearFila();
    </script>

    <script>
        const clienteBusqueda = document.getElementById("clienteBusqueda");
        const clienteResultados = document.getElementById("clienteResultados");
        const razonSocialCliente = document.getElementById("razonSocialCliente");
        const idClienteInput = document.getElementById("IdCliente");

        clienteBusqueda.addEventListener("input", function () {
            const texto = this.value.toLowerCase().trim();
            clienteResultados.innerHTML = "";

            if (texto.length < 1) return;

            const filtrados = clientes.filter(c =>
                c.nit.toLowerCase().includes(texto)
            );

            filtrados.forEach(cliente => {
                const item = document.createElement("button");
                item.type = "button";
                item.className = "list-group-item list-group-item-action";
                item.textContent = `${cliente.nit} - ${cliente.razonSocial}`;

                item.onclick = function () {
                    clienteBusqueda.value = cliente.nit;
                    razonSocialCliente.value = cliente.razonSocial;
                    idClienteInput.value = cliente.id;
                    clienteResultados.innerHTML = "";
                };

                clienteResultados.appendChild(item);
            });
        });

        clienteBusqueda.addEventListener("blur", function () {
            if (this.value.trim() === "") {
                razonSocialCliente.value = "";
                idClienteInput.value = "";
                clienteResultados.innerHTML = "";
            }
        });
    </script>
}
